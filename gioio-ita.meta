    reasmb: Da quanto tempo ti senti (2)?
    reasmb: NET mi sento (2)
  decomp: * sento @felice *
    reasmb: Mi fa piacere che tu ti senta (2)
    reasmb: Cosa ti fa sentire (2)?
    reasmb: NET mi sento (2)
  decomp: * sento *
    reasmb: Perche ti senti (2)?
    reasmb: NET mi sento (2)

key: sei 0

  decomp: * sei tu *
