################ Defaults ######################

key: xnone -1

  decomp: *
    reasmb: Va bene, puoi dirmi qualcosa di piu?
    reasmb: Molto interessante. Puoi darmi qualche dettaglio?
    reasmb: Ti ascolto. Continua...
    reasmb: Continua pure: piu mi racconti, piu posso imparare da te
    reasmb: ...scusa?
    reasmb: Interessante...
    reasmb: Perche dici questo?
    reasmb: Raccontami di piu su questo
    reasmb: NET (1)
    reasmb: NET cosa significa (1)
    reasmb: NET perche (1)
    reasmb: NET parlare di (1)
    reasmb: NET informazioni su (1)

################ Unused ######################

key: NOT_USED -1

  decomp: *
    reasmb: Non sono sicuro di capire del tutto. In altre parole?
    reasmb: Vai avanti
    reasmb: Questo e interessante. Continua
    reasmb: Raccontami di piu
    reasmb: Parlare di questo ti mette a disagio?
    reasmb: Cosa ti fa dire questo?
    reasmb: Si, raccontami qualcosa della tua vita
    reasmb: Che cosa significa per te in particolare?
    reasmb: Prova a restare in contatto con quello che senti davvero
    reasmb: Non capisco bene il tuo atteggiamento
    reasmb: Parlare delle idee a volte aiuta a chiarirle. Continua...
    reasmb: Mi dispiace, non capisco cosa stai cercando di dire
    reasmb: Prego?
    reasmb: Lo dici per una ragione speciale?
    reasmb: Qual e esattamente il punto?
    reasmb: Non avere paura di aprirti un po di piu
    reasmb: Mi piacerebbe tornare a cio di cui parlavamo prima
    reasmb: Sembra che tu stia trattenendo qualcosa
    reasmb: Sono sicuro che questo e importante per te
    reasmb: Fingi di parlare con un amico...
    reasmb: Parlare con me ti aiuta?
    reasmb: Proviamo a restare sull'argomento principale
    reasmb: Uhm, che cosa ti suggerisce?
    reasmb: Ok, descrivi la tua famiglia
    reasmb: Di che altro vorresti parlare oggi?
    reasmb: Descrivi qualcosa che ricordi delle vacanze...
    reasmb: Perche non continui?

################ Abstraction Level 0 ######################

key: si 0

  decomp: * nessuno *
    reasmb: Sei sicuro, nessuno (2)?
    reasmb: Forse qualcuno (2)
    reasmb: Riesci a pensare proprio a qualcuno?
    reasmb: Stai pensando a una persona precisa?
    reasmb: Chi pensi di avere in mente?
    reasmb: NET qualcuno (2)
    reasmb: NET nessuno (2)
  decomp: * @si *
    reasmb: Perche (2)?
    reasmb: Questo ti rende infelice?
    reasmb: Puoi spiegare un po meglio, se vuoi
    reasmb: Perche non mi racconti qualcosa di piu su di te?
    reasmb: Uhm, che cosa ti suggerisce?
    reasmb: Non avere paura di aprirti un po di piu
    reasmb: Ok, continua a descrivere la tua famiglia...
    reasmb: Riesci a mettere a fuoco meglio i tuoi pensieri?
    reasmb: NET (1) (2) (3)
    reasmb: NET motivo per dire (2) (3)

key: no 0

  decomp: * no *
    reasmb: Perche no?
    reasmb: Sei molto sicuro di questo no?
    reasmb: Che cosa succederebbe se fosse si?
    reasmb: NET no (1) (2)

key: sono 0

  decomp: * sono io *
    reasmb: Credi di essere tu (2)?
    reasmb: Vorresti essere tu (2)?
    reasmb: Che cosa vorrebbe dire se fossi tu (2)?
    reasmb: NET essere (2)
    reasmb: NET una persona che e (2)
  decomp: * io sono *
    reasmb: goto io
  decomp: * sono @triste *
    reasmb: Mi dispiace sapere che ti senti (2)
    reasmb: Sono sicuro che non sia piacevole sentirsi (2)
    reasmb: Puoi spiegare cosa ti ha fatto sentire (2)?
    reasmb: Cosa posso fare mentre ti senti (2)?
    reasmb: NET essere (2)
    reasmb: NET perche mi sento (2)
    reasm_for_memory: Dopo aver parlato un po, ti senti ancora (2)?
  decomp: * sono @felice *
    reasmb: Che cosa ti rende (2)?
    reasmb: Riesci a spiegare perche ti senti (2)?
    reasmb: Mi fa piacere che tu sia (2)
    reasmb: NET essere (2)
    reasmb: NET perche sono felice
    reasm_for_memory: Prima hai detto di essere (2). Continua...
  decomp: * sono *
    reasmb: Davvero (2)?
    reasmb: NET (1) sono (2)
    reasmb: NET chi e (2)

key: sento 0

  decomp: * sento @triste *
