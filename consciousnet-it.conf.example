# Consciousnet Italian runtime configuration.
#
# Copy this file to consciousnet.conf, or pass it with:
# ./docgioio --config=consciousnet-it.conf.example
#
# Keep real credentials private.

# Brave Search API credentials. Keep the real token private in consciousnet.conf
# or set BRAVE_SEARCH_API_KEY in the environment.
brave_api_key=YOUR_BRAVE_SEARCH_API_KEY

# Brave Search request options for Italian results.
brave_endpoint=https://api.search.brave.com/res/v1/web/search
brave_country=it
brave_search_lang=it
brave_ui_lang=it-IT
brave_safesearch=moderate
brave_spellcheck=1

# Runtime tuning.
meta_file=gioio-ita.meta
max_answer_words=25
page_size=5
http_timeout=10
